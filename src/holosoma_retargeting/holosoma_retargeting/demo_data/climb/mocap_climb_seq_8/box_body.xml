<mujocoinclude>
    <!-- IMPORTANT: multi_boxes.obj vertices are in absolute coordinates -->
    <!-- So we set position to [0, 0, 0] to let OBJ coordinates take effect directly -->
    <!-- The actual object position is determined by the OBJ file vertices -->
    <body name="multi_boxes_box1_link" pos="0 0 0" quat="1 0 0 0">
        <geom name="multi_boxes_link_1" type="mesh" mesh="box1" pos="0 0 0" quat="1 0 0 0" material="box1_material" contype="1" conaffinity="1"/>
    </body>
    <body name="multi_boxes_box2_link" pos="0 0 0" quat="1 0 0 0">
        <geom name="multi_boxes_link_2" type="mesh" mesh="box2" pos="0 0 0" quat="1 0 0 0" material="box1_material" contype="1" conaffinity="1"/>
    </body>
    <body name="multi_boxes_box3_link" pos="0 0 0" quat="1 0 0 0">
        <geom name="multi_boxes_link_3" type="mesh" mesh="box3" pos="0 0 0" quat="1 0 0 0" material="box1_material" contype="1" conaffinity="1"/>
    </body>
    <body name="multi_boxes_box4_link" pos="0 0 0" quat="1 0 0 0">
        <geom name="multi_boxes_link_4" type="mesh" mesh="box4" pos="0 0 0" quat="1 0 0 0" material="box1_material" contype="1" conaffinity="1"/>
    </body>
</mujocoinclude>
